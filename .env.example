# Database URL:
# For zero-config instant local execution (No Docker required):
DATABASE_URL=sqlite+aiosqlite:///./adbid.db

# If you have Docker or PostgreSQL running, uncomment below:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adbiddb

# Redis URL (falls back automatically to in-memory cache if offline):
REDIS_URL=redis://localhost:6379/0

CACHE_TTL_PUBLISHER=300
CACHE_TTL_SLOT=300
CACHE_TTL_CAMPAIGNS=30
APP_HOST=0.0.0.0
APP_PORT=8000
